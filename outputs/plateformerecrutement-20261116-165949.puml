@startuml
top to bottom direction
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam roundCorner 8
skinparam classAttributeIconSize 0
scale 1.1
title PlateformeRecrutement

hide empty members
abstract class Utilisateur {
  id:int
  nom:string
  email:string
  dateInscription:date
}
class Candidat {
  telephone:string
  ville:string
  disponibilite:string
}
class Recruteur {
  poste:string
}
class Administrateur {
  niveauAcces:string
}
class Entreprise {
  nom:string
  secteur:string
  siteWeb:string
  ville:string
}
class Offre {
  titre:string
  description:string
  typeContrat:TypeContrat
  salaire:float
  dateLimite:date
  statut:StatutOffre
}
class Competence {
  nom:string
}
class CandidatCompetence {
  niveau:string
}
class CV {
  fichierUrl:string
  dateMiseAJour:date
  resume:string
}
class Experience {
  poste:string
  employeur:string
  dateDebut:date
  dateFin:date
}
class Formation {
  diplome:string
  etablissement:string
  anneeObtention:int
}
class Candidature {
  dateSoumission:date
  lettreMotivation:string
  scoreMatching:float
  statut:CandidatureStatut
}
class Entretien {
  date:date
  duree:float
  lieu:string
  mode:ModeEntretien
}
class Evaluation {
  note:float
  commentaire:string
  decision:string
}
class Notification {
  message:string
  dateEnvoi:date
  estLue:bool
}
enum TypeContrat {
  CDI
  CDD
  STAGE
}
enum StatutOffre {
  OUVERTE
  FERMEE
}
enum CandidatureStatut {
  EN_ATTENTE
  PRESELECTIONNEE
  ENTRETIEN
  ACCEPTEE
  REFUSEE
}
enum ModeEntretien {
  PRESENTIEL
  VISIO
}

Candidat --|> Utilisateur
Recruteur --|> Utilisateur
Administrateur --|> Utilisateur
Entreprise "1" -- "*" Recruteur : emploie
Recruteur "1" -- "*" Offre : publie
Offre "*" -- "*" Competence : requiert
Candidat "1" -- "*" CandidatCompetence : a
Competence "1" -- "*" CandidatCompetence : utiliséePar
Candidat "1" -- "1" CV : possède
CV "1" *-- "*" Experience : contient
CV "1" *-- "*" Formation : contient
Candidat "1" -- "*" Candidature : soumet
Offre "1" -- "*" Candidature : recevoir
Candidature "1" -- "*" Entretien : produit
Entretien "1" -- "1" Recruteur : menéPar
Entretien "1" -- "1" Evaluation : produit
Utilisateur "1" -- "*" Notification : reçoit

@enduml
