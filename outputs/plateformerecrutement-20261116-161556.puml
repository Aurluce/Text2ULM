@startuml
top to bottom direction
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam roundCorner 8
skinparam classAttributeIconSize 0
title PlateformeRecrutement

hide empty members
abstract class Utilisateur {
  id: int
  nom: string
  email: string
  dateInscription: date
}
class Candidat {
  telephone: string
  ville: string
  disponibilite: string
}
class Recruteur {
  poste: string
}
class Administrateur {
  niveauAcces: string
}
class Entreprise {
  nom: string
  secteur: string
  siteWeb: string
  ville: string
}
class Offre {
  titre: string
  description: string
  typeContrat: TypeContrat
  salaire: float
  dateLimite: date
  statut: StatutOffre
}
class Competence {
  nom: string
}
class CV {
  fichierUrl: string
  dateMiseAJour: date
  resume: string
}
class Experience {
  poste: string
  employeur: string
  dateDebut: date
  dateFin: date
}
class Formation {
  diplome: string
  etablissement: string
  anneeObtention: int
}
class Candidature {
  dateSoumission: date
  lettreMotivation: string
  scoreMatching: float
  statut: StatutCandidature
}
class Entretien {
  date: datetime
  duree: float
  lieu: string
  mode: ModeEntretien
}
class Evaluation {
  note: float
  commentaire: string
  decision: string
}
class Notification {
  message: string
  dateEnvoi: datetime
  estLue: bool
}
class CandidatCompetence {
  niveau: string
}
enum TypeContrat {
  CDI
  CDD
  STAGE
}
enum StatutOffre {
  OUVERTE
  FERMEE
}
enum StatutCandidature {
  EN_ATTENTE
  PRESELECTIONNEE
  ENTRETIEN
  ACCEPTEE
  REFUSEE
}
enum ModeEntretien {
  PRESENTIEL
  VISIO
}

Candidat --|> Utilisateur
Recruteur --|> Utilisateur
Administrateur --|> Utilisateur
Candidat "1" *-- "1" CV
CV "1" *-- "*" Experience
CV "1" *-- "*" Formation
Candidature "1" *-- "*" Entretien
Entretien "1" *-- "1" Evaluation
Entreprise "1..*" -- "1" Recruteur
Recruteur "1..*" -- "1" Offre
Offre "*" -- "*" Competence
Candidat "1..*" -- "1" CandidatCompetence
Competence "1..*" -- "1" CandidatCompetence
Candidat "1..*" -- "1" Candidature
Offre "1..*" -- "1" Candidature
Entretien "1" -- "1..*" Recruteur
Utilisateur "1..*" -- "1" Notification

@enduml
